generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Association {
  id          Int      @id @default(autoincrement())
  slug        String   @db.VarChar(255)
  user_id     Int
  title       String   @db.VarChar(255)
  category_id Int
  image       String?  @db.VarChar(255)
  links       String?  @db.VarChar(255)
  status      Int      @default(0)
  created_at  DateTime?
  updated_at  DateTime?
  order       Int      @default(0)

  category    AssociationCategory @relation(fields: [category_id], references: [id])

  @@map("associations")
}

model AssociationCategory {
  id          Int      @id @default(autoincrement())
  slug        String   @db.VarChar(255)
  user_id     Int
  title       String   @db.VarChar(255)
  status      Int      @default(0)
  order       Int      @default(0)
  created_at  DateTime?
  updated_at  DateTime?
  description String?

  associations Association[]

  @@map("association_categories")
}

model Banner {
  id          Int      @id @default(autoincrement())
  slug        String   @db.VarChar(255)
  user_id     Int
  title       String   @db.VarChar(255)
  links       String?  @db.VarChar(255)
  image       String?  @db.VarChar(255)
  status      Int      @default(0)
  created_at  DateTime?
  updated_at  DateTime?
  subtitle    String?  @db.VarChar(255)
  summary     String?

  @@map("banners")
}

model Blog {
  id              Int      @id @default(autoincrement())
  slug            String   @db.VarChar(255)
  user_id         Int
  category_id     Int
  title           String   @db.VarChar(255)
  summary         String?
  description     String?
  image           String?  @db.VarChar(255)
  status          Int      @default(0)
  seo_title       String?
  seo_keyword     String?
  seo_description String?
  created_at      DateTime?
  updated_at      DateTime?

  category        BlogCategory @relation(fields: [category_id], references: [id])

  @@map("blogs")
}

model BlogCategory {
  id              Int      @id @default(autoincrement())
  slug            String   @db.VarChar(255)
  user_id         Int
  title           String   @db.VarChar(255)
  status          Int      @default(0)
  image           String?  @db.VarChar(255)
  description     String?
  seo_title       String?
  seo_keyword     String?
  seo_description String?
  created_at      DateTime?
  updated_at      DateTime?

  blogs           Blog[]

  @@map("blog_categories")
}

model Brand {
  id              Int      @id @default(autoincrement())
  user_id         Int
  slug            String   @db.VarChar(255)
  title           String   @db.VarChar(255)
  image           String?  @db.VarChar(255)
  description     String?
  seo_title       String?
  seo_description String?
  seo_keyword     String?
  status          Int      @default(0)
  created_at      DateTime?
  updated_at      DateTime?
  link            String?  @db.VarChar(255)

  products        Product[]

  @@map("brands")
}

model Category {
  id                Int      @id @default(autoincrement())
  slug              String   @db.VarChar(255)
  user_id           Int
  title             String   @db.VarChar(255)
  parent_category   String?  @db.VarChar(255)
  image             String?  @db.VarChar(255)
  description       String?
  seo_title         String?
  seo_keywords      String?
  seo_description   String?
  navigation_status Int      @default(0)
  home_status       Int      @default(0)
  status            Int      @default(0)
  created_at        DateTime?
  updated_at        DateTime?
  subtitle          String?  @db.VarChar(255)
  pdf               String?  @db.VarChar(255)
  link              String?  @db.VarChar(255)
  order             Int      @default(0)
  icon              String?

  products          Product[]

  @@map("categories")
}

model Product {
  id            Int      @id @default(autoincrement())
  slug          String   @db.VarChar(255)
  title         String   @db.VarChar(255)
  user_id       Int
  brand_id      Int?
  category_id   Int
  summary       String?
  description   String
  warranty      String?
  specification String?
  installation  String?
  download      String?
  image         String?  @db.VarChar(255)
  seo_title     String?
  seo_description String?
  seo_keyword   String?
  status        Int      @default(0)
  created_at    DateTime?
  updated_at    DateTime?
  price         String?  @db.VarChar(255)
  sale_price    String?  @db.VarChar(255)
  type          String?  @db.VarChar(255)
  stock         String?  @db.VarChar(255)
  shops         String?
  additionals   Json?

  category      Category @relation(fields: [category_id], references: [id])
  brand         Brand?   @relation(fields: [brand_id], references: [id])
  
  enquiries     ProductEnquiry[]
  reviews       ProductReview[]
  images        Image[]
  downloads     DownloadFile[]

  @@map("products")
}

model ProductEnquiry {
  id           Int      @id @default(autoincrement())
  slug         String   @db.VarChar(255)
  product_id   Int
  name         String   @db.VarChar(255)
  email        String   @db.VarChar(255)
  phone_number String   @db.VarChar(255)
  remarks      String?
  created_at   DateTime?
  updated_at   DateTime?

  product      Product  @relation(fields: [product_id], references: [id])

  @@map("product_enquiries")
}

model ProductReview {
  id         Int      @id @default(autoincrement())
  slug       String   @db.VarChar(255)
  product_id Int
  name       String   @db.VarChar(255)
  email      String   @db.VarChar(255)
  review     String
  rating     Int
  status     Int      @default(1)
  created_at DateTime?
  updated_at DateTime?

  product    Product  @relation(fields: [product_id], references: [id])

  @@map("product_reviews")
}

model Image {
  id         Int      @id @default(autoincrement())
  slug       String   @db.VarChar(255)
  user_id    Int
  product_id Int
  filename   String?  @db.VarChar(255)
  created_at DateTime?
  updated_at DateTime?

  product    Product  @relation(fields: [product_id], references: [id])

  @@map("images")
}

model DownloadFile {
  id         Int      @id @default(autoincrement())
  slug       String   @db.VarChar(255)
  user_id    Int
  product_id Int
  filename   String?  @db.VarChar(255)
  created_at DateTime?
  updated_at DateTime?

  product    Product  @relation(fields: [product_id], references: [id])

  @@map("download_files")
}

model ContactForm {
  id         Int      @id @default(autoincrement())
  slug       String   @db.VarChar(255)
  name       String   @db.VarChar(255)
  email      String   @db.VarChar(255)
  phone      String   @db.VarChar(255)
  subject    String?  @db.VarChar(255)
  message    String
  created_at DateTime?
  updated_at DateTime?

  @@map("contact_forms")
}

model Faq {
  id           Int      @id @default(autoincrement())
  slug         String   @db.VarChar(255)
  user_id      Int
  question     String
  answer       String
  type_id      Int?
  name         String?  @db.VarChar(255)
  email        String?  @db.VarChar(255)
  phone_number String?  @db.VarChar(255)
  status       Int      @default(0)
  created_at   DateTime?
  updated_at   DateTime?

  type         FaqType? @relation(fields: [type_id], references: [id])

  @@map("faqs")
}

model FaqType {
  id         Int      @id @default(autoincrement())
  slug       String   @db.VarChar(255)
  user_id    Int
  title      String   @db.VarChar(255)
  status     Int      @default(0)
  created_at DateTime?
  updated_at DateTime?
  image      String?  @db.VarChar(255)

  faqs       Faq[]

  @@map("faq_types")
}

model Solution {
  id              Int      @id @default(autoincrement())
  user_id         Int
  slug            String   @db.VarChar(255)
  title           String   @db.VarChar(255)
  summary         String?
  description     String?
  additionals     Json?
  download_pdf    String?  @db.VarChar(255)
  download_doc    String?  @db.VarChar(255)
  seo_title       String?
  seo_keyword     String?
  seo_description String?
  image           String?  @db.VarChar(255)
  status          Int?
  created_at      DateTime?
  updated_at      DateTime?
  sub_title       String?  @db.VarChar(255)

  @@map("solutions")
}

model Page {
  id              Int      @id @default(autoincrement())
  slug            String   @db.VarChar(255)
  user_id         Int
  title           String   @db.VarChar(255)
  description     String?
  image           String?  @db.VarChar(255)
  status          Int      @default(0)
  summary         String?
  seo_title       String?
  seo_keyword     String?
  seo_description String?
  created_at      DateTime?
  updated_at      DateTime?

  @@map("pages")
}

model Service {
  id              Int      @id @default(autoincrement())
  slug            String   @db.VarChar(255)
  user_id         Int
  title           String   @db.VarChar(255)
  description     String?
  summary         String?
  image           String?  @db.VarChar(255)
  seo_title       String?  @db.VarChar(255)
  seo_keyword     String?  @db.VarChar(255)
  seo_description String?
  status          Int      @default(0)
  created_at      DateTime?
  updated_at      DateTime?

  @@map("services")
}

model Concern {
  id          Int      @id @default(autoincrement())
  slug        String   @db.VarChar(255)
  user_id     Int
  title       String   @db.VarChar(255)
  image       String?  @db.VarChar(255)
  description String?
  links       String?  @db.VarChar(255)
  status      Int      @default(0)
  created_at  DateTime?
  updated_at  DateTime?
  order       Int      @default(0)

  @@map("concerns")
}

model Subscriber {
  id         Int      @id @default(autoincrement())
  slug       String   @db.VarChar(255)
  email      String   @db.VarChar(255)
  status     Int      @default(0)
  created_at DateTime?
  updated_at DateTime?

  @@map("subscribers")
}

model Testimonial {
  id           Int      @id @default(autoincrement())
  slug         String   @db.VarChar(255)
  user_id      Int
  full_name    String   @db.VarChar(255)
  company_name String?  @db.VarChar(255)
  position     String?  @db.VarChar(255)
  image        String?  @db.VarChar(255)
  message      String
  status       Int      @default(0)
  created_at   DateTime?
  updated_at   DateTime?

  @@map("testimonials")
}

model Reference {
  id              Int      @id @default(autoincrement())
  slug            String   @db.VarChar(255)
  user_id         Int
  category_id     Int
  title           String   @db.VarChar(255)
  image           String?  @db.VarChar(255)
  description     String?
  images          Json?
  seo_title       String?
  seo_keyword     String?
  seo_description String?
  status          Int      @default(0)
  created_at      DateTime?
  updated_at      DateTime?

  category        ReferenceCategory @relation(fields: [category_id], references: [id])

  @@map("references")
}

model ReferenceCategory {
  id         Int      @id @default(autoincrement())
  slug       String   @db.VarChar(255)
  user_id    Int
  title      String   @db.VarChar(255)
  status     Int      @default(0)
  created_at DateTime?
  updated_at DateTime?

  references Reference[]

  @@map("reference_categories")
}

model Plugin {
  id         Int      @id @default(autoincrement())
  slug       String   @db.VarChar(255)
  user_id    Int
  title      String   @db.VarChar(255)
  code       String
  type       String   @db.VarChar(255)
  tag_type   String   @db.VarChar(255)
  status     Int      @default(0)
  created_at DateTime?
  updated_at DateTime?

  @@map("plugins")
}

model Candidate {
  id                Int      @id @default(autoincrement())
  slug              String   @db.VarChar(255)
  name              String   @db.VarChar(255)
  email             String   @db.VarChar(255)
  phone_number      String   @db.VarChar(255)
  current_address   String   @db.VarChar(255)
  permanent_address String   @db.VarChar(255)
  date_of_birth     String   @db.VarChar(255)
  gender            String   @db.VarChar(255)
  post_name         String   @db.VarChar(255)
  education         String   @db.VarChar(255)
  experience        String   @db.VarChar(255)
  resume            String   @db.VarChar(255)
  remarks           String?
  created_at        DateTime?
  updated_at        DateTime?

  @@map("candidates")
}

model Catalogue {
  id         Int      @id @default(autoincrement())
  slug       String   @db.VarChar(255)
  user_id    Int
  title      String   @db.VarChar(255)
  image      String?  @db.VarChar(255)
  file       String   @db.VarChar(255)
  status     Int      @default(0)
  created_at DateTime?
  updated_at DateTime?

  @@map("catalogues")
}

model JobList {
  id              Int      @id @default(autoincrement())
  slug            String   @db.VarChar(255)
  title           String   @db.VarChar(255)
  user_id         Int
  salary          String   @default("Negotiable") @db.VarChar(255)
  deadline        String   @db.VarChar(255)
  education       String?  @db.VarChar(255)
  experience      String?  @db.VarChar(255)
  no_of_vacancy   String?  @db.VarChar(255)
  type            String   @db.VarChar(255)
  description     String?
  summary         String?
  image           String?  @db.VarChar(255)
  order           Int      @default(0)
  seo_title       String?  @db.VarChar(255)
  seo_keyword     String?  @db.VarChar(255)
  seo_description String?
  status          Int      @default(0)
  created_at      DateTime?
  updated_at      DateTime?

  @@map("job_lists")
}

model Shop {
  id         Int      @id @default(autoincrement())
  slug       String   @db.VarChar(255)
  user_id    Int
  title      String   @db.VarChar(255)
  image      String?  @db.VarChar(255)
  status     Int      @default(0)
  created_at DateTime?
  updated_at DateTime?
  website    String?  @db.VarChar(255)

  @@map("shops")
}

model User {
  id                Int       @id @default(autoincrement())
  name              String    @db.VarChar(255)
  email             String    @unique @db.VarChar(255)
  email_verified_at DateTime?
  password          String    @db.VarChar(255)
  phone_number      String?   @db.VarChar(255)
  image             String?   @db.VarChar(255)
  remember_token    String?   @db.VarChar(100)
  created_at        DateTime?
  updated_at        DateTime?

  @@map("users")
}

// Spatie Role/Permission Tables

model Role {
  id         Int      @id @default(autoincrement())
  name       String   @db.VarChar(255)
  guard_name String   @db.VarChar(255)
  created_at DateTime?
  updated_at DateTime?

  @@map("roles")
}

model Permission {
  id         Int      @id @default(autoincrement())
  name       String   @db.VarChar(255)
  guard_name String   @db.VarChar(255)
  created_at DateTime?
  updated_at DateTime?

  @@map("permissions")
}

model ModelHasRole {
  role_id    Int
  model_type String   @db.VarChar(255)
  model_id   Int

  @@id([role_id, model_id, model_type])
  @@map("model_has_roles")
}

model ModelHasPermission {
  permission_id Int
  model_type    String   @db.VarChar(255)
  model_id      Int

  @@id([permission_id, model_id, model_type])
  @@map("model_has_permissions")
}

model RoleHasPermission {
  permission_id Int
  role_id       Int

  @@id([permission_id, role_id])
  @@map("role_has_permissions")
}
